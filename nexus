#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
PORT="${NEXUS_PORT:-8000}"
if ! command -v python3 >/dev/null 2>&1; then
  echo "Python 3 is required. Install Python 3, then run: bash ./nexus"
  exit 1
fi
if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then
  echo "Invalid NEXUS_PORT. Choose a port between 1024 and 65535."
  exit 1
fi
is_nexus_running() {
  NEXUS_PORT="$1" python3 -c 'import os,urllib.request,sys
base="http://127.0.0.1:"+os.environ["NEXUS_PORT"]
try:
 health=urllib.request.urlopen(base+"/api/health",timeout=1)
 setup=urllib.request.urlopen(base+"/api/setup",timeout=1)
 sys.exit(0 if health.status==200 and setup.status==200 else 1)
except Exception: sys.exit(1)'
}
port_is_open() {
  python3 -c 'import socket,sys
s=socket.socket()
try: s.bind(("127.0.0.1",int(sys.argv[1])))
except OSError: sys.exit(1)
else: s.close(); sys.exit(0)' "$1"
}
# Restart this repository's own backend so updated code is loaded. Never kill an unrelated service.
if is_nexus_running "$PORT"; then
  OLD_PID=""
  OLD_ARGS=""
  if [ -f /tmp/nexus-dashboard.pid ]; then
    OLD_PID="$(cat /tmp/nexus-dashboard.pid 2>/dev/null || true)"
    if [ -n "$OLD_PID" ]; then OLD_ARGS="$(ps -p "$OLD_PID" -o args= 2>/dev/null || true)"; fi
  fi
  if [ -n "$OLD_PID" ] && printf '%s' "$OLD_ARGS" | grep -Fq "$ROOT/server.py"; then
    echo "Restarting Nexus Panel backend to apply the current repository code..."
    kill "$OLD_PID" 2>/dev/null || true
    sleep 1
  else
    echo "Nexus Panel is already running on port $PORT under another process."
    echo "No process was stopped. Set NEXUS_PORT to another port if needed."
    exit 0
  fi
fi
if ! is_nexus_running "$PORT"; then
  # Clean up only the legacy static preview process recorded by the previous Nexus launcher.
  if [ -f /tmp/nexus-dashboard.pid ]; then
    OLD_PID="$(cat /tmp/nexus-dashboard.pid 2>/dev/null || true)"
    if [ -n "$OLD_PID" ] && ps -p "$OLD_PID" -o args= 2>/dev/null | grep -Fq "http.server $PORT"; then
      echo "Stopping the old static preview on port $PORT..."
      kill "$OLD_PID" 2>/dev/null || true
      sleep 1
    fi
  fi
  # Restart only the previous Nexus server process from this same repository if it lacks the installer API.
  if [ -f /tmp/nexus-dashboard.pid ]; then
    OLD_PID="$(cat /tmp/nexus-dashboard.pid 2>/dev/null || true)"
    OLD_ARGS=""
    if [ -n "$OLD_PID" ]; then OLD_ARGS="$(ps -p "$OLD_PID" -o args= 2>/dev/null || true)"; fi
    if [ -n "$OLD_PID" ] && printf '%s' "$OLD_ARGS" | grep -Fq "$ROOT/server.py"; then
      echo "Restarting the older Nexus backend to load the installer update..."
      kill "$OLD_PID" 2>/dev/null || true
      sleep 1
    fi
  fi
  # If another service still occupies the port, use the next available one.
  for attempt in $(seq 1 10); do
    if port_is_open "$PORT"; then break; fi
    PORT=$((PORT + 1))
    if [ "$PORT" -gt 65535 ]; then echo "No available port found."; exit 1; fi
  done
  if ! port_is_open "$PORT"; then
    echo "No available port found near the requested port. Set NEXUS_PORT to another free port."
    exit 1
  fi
  export NEXUS_PORT="$PORT"
  # Codespaces needs a forwarded listener; local installs remain loopback-only by default.
  if [[ -z "${NEXUS_HOST:-}" ]]; then
    if [[ -n "${CODESPACE_NAME:-}" ]]; then
      export NEXUS_HOST="0.0.0.0"
      export NEXUS_COOKIE_SECURE="${NEXUS_COOKIE_SECURE:-1}"
    else
      export NEXUS_HOST="127.0.0.1"
    fi
  fi
  echo "Starting Nexus Panel backend on $NEXUS_HOST:$PORT..."
  if [[ "$NEXUS_HOST" != "127.0.0.1" && "$NEXUS_HOST" != "::1" && "$NEXUS_HOST" != "localhost" ]]; then
    echo "SECURITY WARNING: owner login exists, but node isolation and production hardening are incomplete. Keep this Codespaces port PRIVATE."
  fi
  nohup python3 "$ROOT/server.py" > /tmp/nexus-dashboard.log 2>&1 &
  PID=$!
  echo "$PID" > /tmp/nexus-dashboard.pid
  READY=0
  for attempt in $(seq 1 30); do
    if is_nexus_running "$PORT"; then READY=1; break; fi
    if ! kill -0 "$PID" 2>/dev/null; then break; fi
    sleep 0.5
  done
  if [ "$READY" -ne 1 ]; then
    echo "Nexus did not start. Last backend log:"
    cat /tmp/nexus-dashboard.log
    exit 1
  fi
fi
echo
echo "=========================================="
echo "       NEXUS PANEL IS RUNNING"
echo "=========================================="
if [ -n "${CODESPACE_NAME:-}" ]; then
  echo "Installer GUI: https://${CODESPACE_NAME}-${PORT}.app.github.dev/installer.html"
  echo "Dashboard:     https://${CODESPACE_NAME}-${PORT}.app.github.dev/index.html"
  echo "If it does not open automatically: Codespaces > Ports > port $PORT > Open in Browser."
else
  echo "Installer GUI: http://localhost:$PORT/installer.html"
  echo "Dashboard:     http://localhost:$PORT/index.html"
fi
echo "Health check:  http://127.0.0.1:$PORT/api/health"
echo "Database:      $ROOT/data/nexus.sqlite3"
echo "Log:           /tmp/nexus-dashboard.log"
echo
echo "Keep the Codespaces port PRIVATE. Authentication is enabled, but node isolation and production hardening are incomplete."
